APP_NAME=invest-agent-api
APP_ENV=local
LOG_LEVEL=INFO
SYSTEM_RUN_LOG_ENABLED=true
SYSTEM_RUN_LOG_DIR=data/run_logs
SYSTEM_RUN_LOG_MAX_VALUE_CHARS=240
SYSTEM_RUN_LOG_MAX_ITEMS=8
API_HOST=0.0.0.0
API_PORT=8000
WORKER_POLL_INTERVAL_SECONDS=5
TASK_DEFAULT_MAX_ATTEMPTS=3
TASK_RETRY_BACKOFF_SECONDS=5
TASK_WORKER_ID=worker-local-1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=invest_agent
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest

DATABASE_URL=postgresql+psycopg://invest:invest@localhost:5432/invest_agent
REDIS_URL=redis://localhost:6379/0
RAW_STORAGE_DIR=data/raw
DELIVERY_EXPORT_DIR=data/exports
DELIVERY_ENFORCE_POLICY_CHECKS=false
INGESTION_MAX_CHUNK_CHARS=1200
INGESTION_REQUEST_TIMEOUT_SECONDS=20
SOURCE_HTTP_TIMEOUT_SECONDS=20
SOURCE_HTTP_RETRY_COUNT=2
SOURCE_HTTP_BACKOFF_SECONDS=0.3
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_COUNTRY=china
TAVILY_MAX_RESULTS=5
TAVILY_AUTO_PARAMETERS=false
TAVILY_INCLUDE_ANSWER=false
TAVILY_INCLUDE_RAW_CONTENT=false
TAVILY_TIMEOUT_SECONDS=30
# Search discovery provider: anysearch (default) with tavily fallback.
SEARCH_DISCOVERY_PROVIDER=anysearch
SEARCH_DISCOVERY_FALLBACK_PROVIDER=tavily
SEARCH_DISCOVERY_FALLBACK_ENABLED=true
# AnySearch credential (keep empty; fill in local .env only, never commit).
ANYSEARCH_API_KEY=
ANYSEARCH_ENDPOINT=https://api.anysearch.com/mcp
# required -> fail fast if the configured provider needs a credential and none is set.
SEARCH_PROVIDER_POLICY=fallback_allowed
# B.3.3b advisory gap backfill (shadow). Default OFF.
ADVISORY_GAP_BACKFILL_ENABLED=false
ADVISORY_GAP_BACKFILL_MODE=shadow
# C.2 claim-constrained StructuredDraft shadow. Default OFF. Only "shadow" accepted.
STRUCTURED_DRAFT_SHADOW_ENABLED=false
STRUCTURED_DRAFT_SHADOW_MODE=shadow
# C.3.1 Structured Compare. Formal report always comes from Legacy Editor1.
# editor1_mode allowed: legacy / structured_compare / structured_primary_canary / structured_primary
EDITOR1_MODE=legacy
STRUCTURED_EDITOR1_COMPARE_ENABLED=false
STRUCTURED_EDITOR1_MAX_RETRIES=1
EIA_API_KEY=
SEC_USER_AGENT=invest-agent/0.1 (research@local)
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_RESEARCH_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=180
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_MODEL_SUPERVISOR_INTAKE=
DEEPSEEK_MODEL_THESIS_BUILDER=
DEEPSEEK_MODEL_OPPONENT=
DEEPSEEK_MODEL_EVIDENCE_JUDGE=
DEEPSEEK_MODEL_RISK_ANALYST=
DEEPSEEK_MODEL_SYNTHESIZE_MEMO=
DEEPSEEK_ENABLE_THINKING=false
DEEPSEEK_STORE_REASONING_CONTENT=false
